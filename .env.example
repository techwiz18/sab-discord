# Copy to .env (local dev only — in AMP set these as instance env vars instead)
DISCORD_TOKEN=your-bot-token-here
# Also used for instant slash-command sync (guild sync is instant; without it, global sync takes up to an hour)
GUILD_ID=123456789012345678
CHANNEL_ID=123456789012345678
ROLE_ID=123456789012345678
IDLE_MINUTES=60  # boot default; adjustable live via command (resets on restart)
CHECK_INTERVAL_SECONDS=300  # boot default; adjustable live via command (resets on restart)
# Fallback single message (only used when PING_MESSAGES and messages.txt are both empty/missing)
PING_TEXT=Checking in — anything needed here?
# OPTION A (recommended): ||-separated pool, picked at random per ping.
# Takes priority over messages.txt and survives AMP Updates (lives in untracked .env).
# Example: PING_MESSAGES=First message here || Second message here || Third one
PING_MESSAGES=
# OPTION B: one message per line in messages.txt (auto-created from
# messages.example.txt on first run, reloaded every ping, no restart needed,
# and never overwritten by updates).
MESSAGES_FILE=messages.txt
HISTORY_SCAN_LIMIT=50
LOG_LEVEL=INFO
# Slash-command access: space/comma-separated role IDs allowed to use ANY bot
# command (messages list/add/remove, ping-status). Empty = Administrators only.
# Set this only if a non-admin helper needs to manage the message pool.
MANAGER_ROLE_IDS=
# Optional cap on file-managed messages (default 50)
# MAX_FILE_MESSAGES=50
